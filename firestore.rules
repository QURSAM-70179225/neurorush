rules_version = '2';

// NeuroRush security rules.
// Principle: clients may only write their own *non-competitive* data.
// Scores, XP, levels, leaderboards, achievements and friendships are written
// exclusively by Cloud Functions (Admin SDK bypasses these rules) after
// server-side validation.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function changedOnly(fields) {
      return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(fields);
    }

    // ---- Public player profile -------------------------------------------
    // Readable by any signed-in player (friends, leaderboards).
    // Owner may only edit cosmetic fields; streaks, freezes, coins and
    // entitlements are server-managed.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && changedOnly(['displayName', 'country', 'photoUrl', 'lastActiveAt'])
        && validClientProfile(request.resource.data);
      allow delete: if false;

      function validClientProfile(d) {
        return (!('displayName' in d) || d.displayName == null || (d.displayName is string && d.displayName.size() <= 30))
          && (!('country' in d) || d.country == null || (d.country is string && d.country.matches('^[A-Z]{2}$')))
          && (!('photoUrl' in d) || d.photoUrl == null || (d.photoUrl is string && d.photoUrl.size() <= 500))
          && (!('lastActiveAt' in d) || d.lastActiveAt is timestamp);
      }

      // Private per-user data (progress items, settings). Owner only.
      match /private/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

    // Username → uid index; claimed via the claimUsername function.
    match /usernames/{name} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Validated rounds; written only by submitGameSession.
    match /gameSessions/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Daily workout completion, owner only.
    match /dailyWorkouts/{uid}/days/{day} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && day.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.keys().hasOnly(['games', 'completed', 'updatedAt'])
        && request.resource.data.games is list && request.resource.data.games.size() <= 3
        && request.resource.data.completed is list && request.resource.data.completed.size() <= 3;
    }

    // Weekly boards; entries written only by submitGameSession.
    match /leaderboards/{weekId} {
      allow read: if signedIn();
      allow write: if false;
      match /entries/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Friends and requests are managed by functions; owners can read and
    // decline (delete) incoming requests.
    match /friends/{uid} {
      match /list/{friendUid} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /requests/{fromUid} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if false;
      }
    }

    // Unlocked badges: visible to other players, granted by functions only.
    match /achievements/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // AI coach tips (cached by getBrainCoachTip). Owner may read.
    match /coachTips/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Endless puzzles contain the answer: never readable by clients.
    match /endlessPuzzles/{id} {
      allow read, write: if false;
    }

    // Rewarded-ad grants written by the AdMob SSV callback.
    match /rewardGrants/{id} {
      allow read, write: if false;
    }

    // Purchases are verified with Google Play and recorded server-side.
    match /purchases/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Live battles: players watch the doc in real time; every change goes
    // through Cloud Functions. Answers live in /secret and are never readable.
    match /battles/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.players;
      allow write: if false;
      match /secret/{doc} {
        allow read, write: if false;
      }
    }

    // Matchmaking queue: a waiting player watches their own entry to learn
    // the battle id once someone pairs with them.
    match /matchQueue/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /invites/{code} {
      allow read, write: if false;
    }

    // Push settings and device tokens, written by the owner's app.
    match /pushTargets/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['tokens', 'tzOffsetMinutes', 'reminderHourUtc', 'workoutHourUtc', 'prefs', 'updatedAt'])
        && request.resource.data.tokens is list && request.resource.data.tokens.size() <= 10
        && request.resource.data.tzOffsetMinutes is int
        && request.resource.data.tzOffsetMinutes >= -840 && request.resource.data.tzOffsetMinutes <= 840
        && request.resource.data.reminderHourUtc is int
        && request.resource.data.reminderHourUtc >= 0 && request.resource.data.reminderHourUtc <= 23
        && request.resource.data.workoutHourUtc is int
        && request.resource.data.workoutHourUtc >= 0 && request.resource.data.workoutHourUtc <= 23
        && request.resource.data.prefs is map;
    }

    match /pushLog/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
